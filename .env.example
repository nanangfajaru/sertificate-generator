# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Hanya dipakai di server (JANGAN diawali NEXT_PUBLIC_). Dipakai untuk halaman publik peserta.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publik aplikasi (dipakai untuk QR verifikasi & redirect OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email sistem (konfirmasi pendaftaran & reset password) dikirim lewat SMTP sendiri, bukan mailer Supabase.
# Cocok dengan penyedia SMTP apa pun (Resend, Brevo, Mailgun, Gmail App Password, dst.).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sertifikat Online <no-reply@domain-anda.com>"
